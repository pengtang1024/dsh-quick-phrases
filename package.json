{
  "name": "@local/dsh-quick-phrases",
  "version": "0.3.2",
  "private": true,
  "description": "Quick phrase chips under the composer with a managed phrase list (label and sent text are separate).",
  "license": "MIT",
  "author": {
    "name": "pengtang1024",
    "email": "pengtang1024@qq.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pengtang1024/dsh-quick-phrases.git"
  },
  "homepage": "https://github.com/pengtang1024/dsh-quick-phrases#readme",
  "bugs": {
    "url": "https://github.com/pengtang1024/dsh-quick-phrases/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "quick-phrases",
    "composer",
    "chips",
    "productivity"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
