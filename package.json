{
  "name": "dsh-quick-phrases",
  "version": "0.3.5",
  "description": "DSH 快捷短语：输入框旁一排短语按钮，点按即发送；管理页可增删改、拖动排序，显示名称与发送内容分离，显示位置可选。",
  "license": "MIT",
  "author": {
    "name": "pengtang1024",
    "email": "pengtang1024@qq.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pengtang1024/dsh-quick-phrases.git"
  },
  "homepage": "https://github.com/pengtang1024/dsh-quick-phrases#readme",
  "bugs": {
    "url": "https://github.com/pengtang1024/dsh-quick-phrases/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "quick-phrases",
    "quick-reply",
    "canned-responses",
    "productivity"
  ],
  "engines": {
    "node": ">=20",
    "dsh": "^0.2.2-rc.3"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
